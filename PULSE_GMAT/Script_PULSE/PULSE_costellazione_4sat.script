%==========================================================================
% PULSE - Fase A - Costellazione di 4 satelliti eliosincroni sullo stesso piano
%
% Correzioni rispetto alla versione precedente:
%  1) Orbite definite con elementi MEDI (Brouwer-Lyddane, BrouwerMeanShort)
%     invece che osculanti: tutti i satelliti hanno lo stesso semiasse medio
%     (6680.2 km, come nel paper di EarthNext), quindi lo stesso periodo,
%     e restano distanziati di 90 gradi per tutta la simulazione.
%  2) Ogni satellite e' distanziato cambiando SOLO l'anomalia media (MA):
%     0, 90, 180, 270 gradi.
%  3) Ogni ContactLocator (passo di ricerca di default 10 s) ha il proprio Target e il proprio file di uscita
%     (12 locator: 4 satelliti x accessi 30 deg, accessi 45 deg, contatti).
%  4) ReportFile di controllo del distanziamento (argomento di latitudine
%     = AOP + TA di ogni satellite, una riga ogni 10 minuti).
%
% Durata: 30 giorni (3 cicli di ripetizione della traccia da 10 giorni).
% Bersagli: elevazione minima 58.4 deg = 30 deg off-nadir,
%           elevazione minima 42.2 deg = 45 deg off-nadir (da 302 km).
% NB: script non eseguito in GMAT da chi lo ha scritto; se una riga da'
%     errore nella vostra versione, il messaggio di GMAT indica quale.
%==========================================================================

%----------------------------------------
% Satelliti (elementi medi Brouwer-Lyddane, forma "short")
%----------------------------------------
Create Spacecraft PULSE;
PULSE.DateFormat = UTCGregorian;
PULSE.Epoch = '01 Jan 2026 13:00:00.000';
PULSE.CoordinateSystem = EarthMJ2000Eq;
PULSE.DisplayStateType = BrouwerMeanShort;
PULSE.BrouwerShortSMA = 6680.200000002525;
PULSE.BrouwerShortECC = 0.001099999999820183;
PULSE.BrouwerShortINC = 96.80000000000094;
PULSE.BrouwerShortRAAN = 78.69999999999999;
PULSE.BrouwerShortAOP = 90.00000000000006;
PULSE.BrouwerShortMA = 0;
PULSE.DryMass = 30;
PULSE.Cd = 2.2;
PULSE.Cr = 1.8;
PULSE.DragArea = 0.1;
PULSE.SRPArea = 1;
PULSE.SPADDragScaleFactor = 1;
PULSE.SPADSRPScaleFactor = 1;
PULSE.AtmosDensityScaleFactor = 1;
PULSE.ExtendedMassPropertiesModel = 'None';
PULSE.NAIFId = -10001001;
PULSE.NAIFIdReferenceFrame = -9001001;
PULSE.OrbitColor = Red;
PULSE.TargetColor = Teal;
PULSE.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
PULSE.CdSigma = 1e+70;
PULSE.CrSigma = 1e+70;
PULSE.Id = 'SatId';
PULSE.Attitude = CoordinateSystemFixed;
PULSE.SPADSRPInterpolationMethod = Bilinear;
PULSE.SPADSRPScaleFactorSigma = 1e+70;
PULSE.SPADDragInterpolationMethod = Bilinear;
PULSE.SPADDragScaleFactorSigma = 1e+70;
PULSE.AtmosDensityScaleFactorSigma = 1e+70;
PULSE.ModelFile = 'aura.3ds';
PULSE.ModelOffsetX = 0;
PULSE.ModelOffsetY = 0;
PULSE.ModelOffsetZ = 0;
PULSE.ModelRotationX = 0;
PULSE.ModelRotationY = 0;
PULSE.ModelRotationZ = 0;
PULSE.ModelScale = 1;
PULSE.AttitudeDisplayStateType = 'Quaternion';
PULSE.AttitudeRateDisplayStateType = 'AngularVelocity';
PULSE.AttitudeCoordinateSystem = EarthMJ2000Eq;
PULSE.EulerAngleSequence = '321';

