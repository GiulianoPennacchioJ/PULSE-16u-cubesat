%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create ReportFile Distanziamento;
Distanziamento.SolverIterations = Current;
Distanziamento.UpperLeft = [ 0 0 ];
Distanziamento.Size = [ 0 0 ];
Distanziamento.RelativeZOrder = 0;
Distanziamento.Maximized = false;
Distanziamento.Filename = 'PULSE_distanziamento.txt';
Distanziamento.Precision = 16;
Distanziamento.WriteHeaders = true;
Distanziamento.LeftJustify = On;
Distanziamento.ZeroFill = Off;
Distanziamento.FixedWidth = true;
Distanziamento.Delimiter = ' ';
Distanziamento.ColumnWidth = 23;
Distanziamento.WriteReport = true;
Distanziamento.AppendToExistingFile = false;

%----------------------------------------
% Grafico della traccia a terra (vista 3D non inclusa per velocita')
%----------------------------------------
Create GroundTrackPlot Traccia;
Traccia.SolverIterations = Current;
Traccia.UpperLeft = [ 0 0 ];
Traccia.Size = [ 0 0 ];
Traccia.RelativeZOrder = 0;
Traccia.Maximized = false;
Traccia.Add = {PULSE, PULSE2, PULSE3, PULSE4};
Traccia.DataCollectFrequency = 1;
Traccia.UpdatePlotFrequency = 50;
Traccia.NumPointsToRedraw = 0;
Traccia.ShowPlot = false;
Traccia.MaxPlotPoints = 20000;
Traccia.CentralBody = Earth;
Traccia.TextureMap = 'ModifiedBlueMarble.jpg';

%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------

%----------------------------------------
% Controllo del distanziamento: argomento di latitudine = AOP + TA
% (le differenze tra satelliti consecutivi devono restare ~90 deg)
%----------------------------------------
Create Variable u1 u2 u3 u4 k;


%----------------------------------------
%---------- Mission Sequence
%----------------------------------------


%==========================================================================
BeginMissionSequence;

% 30 giorni = 4320 passi da 10 minuti; ogni 10 minuti si scrive una riga
% di controllo del distanziamento
k = 0;
While k < 4320
   k = k + 1;
   Propagate PropPULSE(PULSE, PULSE2, PULSE3, PULSE4) {PULSE.ElapsedSecs = 600};
   u1 = PULSE.EarthMJ2000Eq.AOP + PULSE.Earth.TA;
   u2 = PULSE2.EarthMJ2000Eq.AOP + PULSE2.Earth.TA;
   u3 = PULSE3.EarthMJ2000Eq.AOP + PULSE3.Earth.TA;
   u4 = PULSE4.EarthMJ2000Eq.AOP + PULSE4.Earth.TA;
   Report Distanziamento PULSE.UTCGregorian u1 u2 u3 u4;
EndWhile;
