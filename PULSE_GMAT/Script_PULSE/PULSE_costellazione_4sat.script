%----------------------------------------
% Modello di forze e propagatore
% Drag spento: in missione la propulsione mantiene quota e distanziamento.
%----------------------------------------
Create ForceModel FM;
FM.CentralBody = Earth;
FM.PrimaryBodies = {Earth};
FM.PointMasses = {Sun, Luna};
FM.Drag = None;
FM.SRP = Off;
FM.RelativisticCorrection = Off;
FM.ErrorControl = RSSStep;
FM.GravityField.Earth.Degree = 4;
FM.GravityField.Earth.Order = 4;
FM.GravityField.Earth.StmLimit = 100;
FM.GravityField.Earth.PotentialFile = 'JGM3.cof';
FM.GravityField.Earth.TideModel = 'None';

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator PropPULSE;
PropPULSE.FM = FM;
PropPULSE.Type = RungeKutta89;
PropPULSE.InitialStepSize = 60;
PropPULSE.Accuracy = 9.999999999999999e-12;
PropPULSE.MinStep = 0.001;
PropPULSE.MaxStep = 60;
PropPULSE.MaxStepAttempts = 50;
PropPULSE.StopIfAccuracyIsViolated = true;

%----------------------------------------
% Accessi a 30 deg (un locator per satellite)
%----------------------------------------
Create ContactLocator Accessi30_1;
Accessi30_1.Target = PULSE;
Accessi30_1.Filename = 'PULSE_accessi_30deg.txt';
Accessi30_1.OccultingBodies = {Earth};
Accessi30_1.InputEpochFormat = 'TAIModJulian';
Accessi30_1.InitialEpoch = '21545';
Accessi30_1.StepSize = 10;
Accessi30_1.FinalEpoch = '21545.138';
Accessi30_1.UseLightTimeDelay = false;
Accessi30_1.UseStellarAberration = false;
Accessi30_1.WriteReport = true;
Accessi30_1.RunMode = Automatic;
Accessi30_1.UseEntireInterval = true;
Accessi30_1.Observers = {Aosta30, Gemona30, Napoli30, Norcia30, Palermo30};
Accessi30_1.LightTimeDirection = Transmit;
Accessi30_1.LeftJustified = false;
Accessi30_1.ReportPrecision = 6;
Accessi30_1.ReportFormat = 'Legacy';
Accessi30_1.IntervalStepSize = 0;
Accessi30_1.ReportTimeFormat = 'UTCGregorian';

