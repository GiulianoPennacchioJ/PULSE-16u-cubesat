%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel PropPULSE_ForceModel;
PropPULSE_ForceModel.CentralBody = Earth;
PropPULSE_ForceModel.PrimaryBodies = {Earth};
PropPULSE_ForceModel.PointMasses = {Luna, Sun};
PropPULSE_ForceModel.Drag = None;
PropPULSE_ForceModel.SRP = Off;
PropPULSE_ForceModel.RelativisticCorrection = Off;
PropPULSE_ForceModel.ErrorControl = RSSStep;
PropPULSE_ForceModel.GravityField.Earth.Degree = 4;
PropPULSE_ForceModel.GravityField.Earth.Order = 4;
PropPULSE_ForceModel.GravityField.Earth.StmLimit = 100;
PropPULSE_ForceModel.GravityField.Earth.PotentialFile = 'JGM3.cof';
PropPULSE_ForceModel.GravityField.Earth.TideModel = 'None';

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator PropPULSE;
PropPULSE.FM = PropPULSE_ForceModel;
PropPULSE.Type = RungeKutta89;
PropPULSE.InitialStepSize = 60;
PropPULSE.Accuracy = 9.999999999999999e-12;
PropPULSE.MinStep = 0.001;
PropPULSE.MaxStep = 60;
PropPULSE.MaxStepAttempts = 50;
PropPULSE.StopIfAccuracyIsViolated = true;

